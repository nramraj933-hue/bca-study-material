#include<iostream.h>
#include<conio.h>
#include<string.h>
class student
{
 public:
 char rollno,name;
 publc:
 student(int x1,int y2)
 {
  rollno=x1;
  name=y2;
  }
  void show()
  {
  cout<<"student rollno:"<<rollno<<endl;
  cout<<"student name:"<<name<<endl;
  }
 };
 class result: public student
 {
   public:
    int a,b;
    public:
     child(int x1,int y2,int c1,int c2):student(x1,y2)
     {
     a=c1;
     b=c2;
     }
     void display()
     {
     cout<<"student marks:"<<a<<endl;
     cout<<"student marks:"<<b<<endl;
     }
   };
   void main()
   {
   clrscr();
   result obj(1,2,3,4);
   obj.show();
   obj.display();
   getch();
}